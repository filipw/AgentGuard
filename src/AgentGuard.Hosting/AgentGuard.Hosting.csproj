<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>DI registration and configuration binding for AgentGuard. Rules that live outside the core engine (Azure, out-of-process PII) plug in through IGuardrailRuleFactory, so this package does not pull their dependencies in.</Description>
    <PackageId>AgentGuard.Hosting</PackageId>
    <RootNamespace>AgentGuard.Hosting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentGuard.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentGuard/AgentGuard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>
</Project>
