    <PackageId>AgentGuard.Pii</PackageId>
    <RootNamespace>AgentGuard.Pii</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentGuard.Core/AgentGuard.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TasmanianDevil" />
  </ItemGroup>
</Project>
