<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- standalone eng tool, intentionally not in AgentGuard.slnx so CI doesn't build it.
         Gate 2/3: confirms the C# GLiNER input assembly (Microsoft.ML.Tokenizers' SentencePieceTokenizer
         over the mdeberta spm + manual <<ENT>>/<<SEP>>/CLS/SEP insertion + words_mask) reproduces the
         gliner-lib collated tensors id-for-id, AND that the C# sigmoid + flat-greedy span decode
         reproduces the library's decoded char spans. Reads eng/models/gliner/fixtures.json (dumped by
         eng/gliner-eval/export_onnx.py). The inference here mirrors AgentGuard.Onnx.GlinerModelSession;
         the production rule itself is covered by the gated E2E tests. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>
</Project>
